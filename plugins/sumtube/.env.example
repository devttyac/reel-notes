# Copy this file to ~/.config/sumtube/.env and fill in your keys:
#
#   mkdir -p ~/.config/sumtube
#   cp .env.example ~/.config/sumtube/.env
#   chmod 600 ~/.config/sumtube/.env
#
# SumTube reads keys from the process environment and from that file only.
# A .env file inside the plugin folder is NOT read (since 0.2.0).
#
# Why SUMTUBE_API_KEY exists:
# Claude Code's sandbox injects an empty ANTHROPIC_API_KEY into all child
# processes, overwriting any shell-level value. SumTube therefore accepts
# SUMTUBE_API_KEY only; ANTHROPIC_API_KEY is deliberately not read, so SumTube
# can never pick up ANTHROPIC_API_KEY by accident (if that variable is set,
# Claude Code may switch a subscriber to API billing).

SUMTUBE_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional — enables Whisper transcription fallback for caption-less videos.
GROQ_API_KEY=gsk_your-groq-api-key-here
